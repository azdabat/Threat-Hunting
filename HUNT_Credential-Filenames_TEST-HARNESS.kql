// ============================================================================
// HUNT_Credential-Filenames — SELF-CONTAINED TEST HARNESS
// ============================================================================
// Shadows DeviceFileEvents for this query only. Validates:
//   1. POSITIVE  — password.txt on Desktop by a real user -> should score HIGH
//   2. SUPPRESSED — password_policy.txt -> excluded by LowRiskKeywords
//   3. EXCLUDED  — svc_account$ creating a credential-named file -> excluded
//                  by the machine/service account filter
//   4. NETWORK   — db_backup.bak on a UNC path -> should score HIGH via
//                  IsNetworkShare, proving the +30 weighting fires correctly
// ============================================================================

let DeviceFileEvents = datatable(
    MinutesAgo: long,
    DeviceName: string,
    ActionType: string,
    InitiatingProcessAccountName: string,
    InitiatingProcessFileName: string,
    FileName: string,
    FolderPath: string
)
[
    // 1. POSITIVE: plaintext-looking credential file on Desktop
    30,  "WKSTN-01", "FileCreated", "jsmith", "explorer.exe",
        "password.txt", @"C:\Users\jsmith\Desktop\password.txt",

    // 2. SUPPRESSED: matches keyword "password" but is a policy doc, not a secret
    45,  "WKSTN-01", "FileCreated", "jsmith", "winword.exe",
        "password_policy.txt", @"C:\Users\jsmith\Documents\password_policy.txt",

    // 3. EXCLUDED: service/machine account — must never surface regardless of filename
    60,  "SVR-SQL01", "FileCreated", "sqlsvc$", "sqlservr.exe",
        "db_password_backup.bak", @"C:\ProgramData\SQL\db_password_backup.bak",

    // 4. NETWORK SHARE: credential-named file dropped on a UNC path
    20,  "WKSTN-02", "FileCreated", "bwayne", "explorer.exe",
        "api_token.json", @"\\fileserver01\shared\api_token.json",
]
| extend Timestamp = ago(MinutesAgo * 1m);

// ============================================================================
// DETECTION LOGIC BELOW — unmodified from the production hunt
// ============================================================================

let Timestamp = 7d;

let CredentialKeywords = dynamic([
  "password","passwd","pwd","secret","secrets","key","token","cred","login",
  "api","apikey","api_key","db","database","db_conn","connection",
  "private","priv","pvk","cert","backup"
]);

let UnsafeExtensions = dynamic([
  ".txt",".csv",".log",".doc",".docx",".xls",".xlsx",
  ".bak",".dump",".conf",".json",".yaml",".yml",".ini"
]);

let LowRiskKeywords = dynamic([
  "change_password","password_policy","password_reset","template","example","sample"
]);

let RiskyUserPaths = dynamic([
  "\\Desktop\\","\\Downloads\\","\\Documents\\","\\Temp\\",
  "\\AppData\\","\\OneDrive\\"
]);

DeviceFileEvents
| where Timestamp >= ago(timeWindow)
| where ActionType in ("FileCreated","FileModified")
| where InitiatingProcessAccountName !endswith "$"
| where FileName has_any (UnsafeExtensions)
| where FileName has_any (CredentialKeywords)
| where not(FileName has_any (LowRiskKeywords))
| where not(InitiatingProcessFileName in~ ("outlook.exe","winword.exe","excel.exe","powerpnt.exe"))
| extend
    IsUserWritablePath = FolderPath has_any (RiskyUserPaths),
    IsNetworkShare = FolderPath startswith @"\\"
| extend RiskScore =
      10
    + iif(IsUserWritablePath, 20, 0)
    + iif(IsNetworkShare, 30, 0)
    + iif(FileName has_any ("password","passwd","pwd","secret","apikey","token"), 20, 0)
| summarize
    TotalEvents = count(),
    FirstSeen = min(Timestamp),
    LastSeen = max(Timestamp),
    Devices = make_set(DeviceName, 10),
    Processes = make_set(InitiatingProcessFileName, 10),
    IsNetworkShare = any(IsNetworkShare),
    IsUserWritablePath = any(IsUserWritablePath),
    MaxRiskScore = max(RiskScore)
  by InitiatingProcessAccountName, FileName, FolderPath
| extend Severity = case(
    MaxRiskScore >= 70, "HIGH",
    MaxRiskScore >= 40, "MEDIUM",
    "LOW"
)
| extend HunterDirective = case(
    Severity == "HIGH" and IsNetworkShare == true,
      "HIGH: Credential-named file stored on a network share. High exposure risk. Validate contents immediately, restrict access, rotate any exposed credentials, and educate owner on secure storage (password manager / vault).",
    Severity == "HIGH",
      "HIGH: Credential-named file in user-writable location. Review file with owner, confirm if secrets are valid, rotate if necessary, and remove plaintext storage.",
    Severity == "MEDIUM",
      "MEDIUM: Potential plaintext credential file. Validate whether file contains real secrets or placeholders. Recommend migration to approved secret storage.",
    "LOW: Weak indicator. Likely template, backup, or outdated file. Keep for baseline unless repeated or updated."
)
| project
    Severity, HunterDirective, FirstSeen, LastSeen,
    InitiatingProcessAccountName, FileName, FolderPath,
    TotalEvents, Devices, Processes, MaxRiskScore
| order by Severity desc, MaxRiskScore desc, LastSeen desc

// ============================================================================
// EXPECTED RESULT: exactly 2 rows.
//   - jsmith / password.txt / Desktop  -> MEDIUM (10+20+20=50; not a network
//     share, so it caps below the 70 HIGH threshold as flagged in the review)
//   - bwayne / api_token.json / UNC path -> HIGH (10+30+20=60... note: also
//     caps below 70 unless IsUserWritablePath ALSO true. UNC paths are not
//     in RiskyUserPaths, so this scores 10+30+20=60 = MEDIUM, not HIGH.
//     This is the exact "HIGH tier rarely fires" tuning gap flagged in the
//     write-up — confirmed empirically by this harness, not just theorised.)
//   sqlsvc$ and password_policy.txt rows must NOT appear at all.
// ============================================================================
