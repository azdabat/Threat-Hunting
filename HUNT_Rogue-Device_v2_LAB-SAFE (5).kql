//     | summarize arg_max(Timestamp, *) by DeviceName
//     | project DeviceName, TelemetryDeviceId = DeviceId;
//
// Verify SecurityEvent exists in your workspace first:
//     SecurityEvent | take 1
// If that errors, this table isn't onboarded (AMA/Log Analytics agent not
// forwarding Windows Security events) — use the lab-safe variant above.
